#!/usr/bin/env bash
# 此脚本由 root 所有（chown root:root），ubuntu 不可修改。
# 唯一功能：从固定的 GitHub 仓库拉取最新安装脚本覆盖 /opt/install-scripts/，
# 并在结束时强制将目录权限锁回 root，确保 ubuntu 无法直接写入。
set -euo pipefail

TARBALL_URL="https://github.com/qhkly/webclaw-software-manager/archive/refs/heads/main.tar.gz"
PREINSTALL_URL="https://raw.githubusercontent.com/qhkly/webclaw-software-manager/main/preinstall-full-apps.json"

mkdir -p /opt/install-scripts

curl -fsSL --max-time 60 "$TARBALL_URL" \
  | tar -xz --strip-components=2 -C /opt/install-scripts/ \
    "webclaw-software-manager-main/scripts/" 2>/dev/null

chmod +x /opt/install-scripts/*.sh 2>/dev/null || true

# 每次写入后强制锁回 root 所有、755 权限，断绝 ubuntu 写入路径
chown root:root /opt/install-scripts
chmod 755 /opt/install-scripts

curl -fsSL --max-time 30 "$PREINSTALL_URL" \
  -o /opt/preinstall-full-apps.json 2>/dev/null || true

echo "updated"
