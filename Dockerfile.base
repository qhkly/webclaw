FROM ubuntu:24.04

LABEL org.opencontainers.image.title="webclaw-base" \
      org.opencontainers.image.description="Base image with code-server IDE and Supervisor (no desktop components)" \
      org.opencontainers.image.url="https://github.com/land007/webclaw" \
      org.opencontainers.image.source="https://github.com/land007/webclaw" \
      org.opencontainers.image.vendor="land007" \
      org.opencontainers.image.licenses="SSPL-1.0" \
      org.opencontainers.image.logo="https://raw.githubusercontent.com/land007/webclaw/main/images/icon-source.png"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=zh_CN.UTF-8
ENV LANGUAGE=zh_CN:zh
ENV LC_ALL=zh_CN.UTF-8
ENV WEBCODE_HAS_VIBE_KANBAN=false
ENV WEBCODE_HAS_CLAUDECODEUI=false

# ─── 1. Base system: locale, sudo, ubuntu user, common CLI tools ─────
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales sudo ca-certificates curl wget git gnupg \
        openssl software-properties-common \
        vim nano less file tree htop lsof procps \
        zip unzip tar xz-utils jq \
        net-tools iputils-ping iproute2 dnsutils openssh-client \
        xdg-utils bash-completion \
    && locale-gen en_US.UTF-8 zh_CN.UTF-8 \
    && update-locale LANG=zh_CN.UTF-8 \
    && (id ubuntu &>/dev/null && usermod -s /bin/bash -aG sudo ubuntu || useradd -m -s /bin/bash -G sudo ubuntu) \
    && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 1b. GitHub CLI (gh) ───────────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y gh \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=22.22.1

# ─── 2. Node.js 22.22.1 (pinned) ────────────────────────────────────
RUN ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in \
         amd64) NODE_ARCH=x64 ;; \
         arm64) NODE_ARCH=arm64 ;; \
         *) echo "Unsupported Node.js architecture: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm -f /tmp/node.tar.xz

# ─── 2a. Native module build dependencies for node-pty ──────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-dev \
        build-essential \
        libsecret-1-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install setuptools for Python distutils compatibility (needed for node-gyp)
RUN apt-get update && apt-get install -y --no-install-recommends python3-setuptools \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 2b. webclaw-dashboard-server (includes http-proxy as dependency) ─
RUN npm install -g webclaw-dashboard-server@latest

# ─── 4. code-server (pre-compiled binary — replaces Theia build) ────
ARG CODE_SERVER_VERSION=4.100.2
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL -A "Mozilla/5.0" -L "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-${ARCH}.tar.gz" \
       | tar -C /opt -xz \
    && mv /opt/code-server-${CODE_SERVER_VERSION}-linux-${ARCH} /opt/code-server \
    && ln -s /opt/code-server/bin/code-server /usr/local/bin/code-server \
    && chown -R ubuntu:ubuntu /opt/code-server

# ─── 4b. code-server language pack extensions ────────────────
# 使用重试机制安装语言包，VS Code 扩展市场可能返回 502
RUN mkdir -p /opt/code-server-extensions \
    && for i in 1 2 3 4 5; do \
         success=true; \
         for ext in \
             MS-CEINTL.vscode-language-pack-zh-hans \
             MS-CEINTL.vscode-language-pack-ja \
             MS-CEINTL.vscode-language-pack-es \
             MS-CEINTL.vscode-language-pack-pt-BR \
             MS-CEINTL.vscode-language-pack-ko \
             MS-CEINTL.vscode-language-pack-de; do \
           if ! code-server --extensions-dir /opt/code-server-extensions --install-extension "$ext" 2>/dev/null; then \
               success=false; \
               echo "[Extension] Failed to install $ext (attempt $i/5)"; \
           fi; \
         done; \
         if [ "$success" = true ]; then \
             break; \
         fi; \
         echo "[Extension] Retrying in 10s..."; \
         sleep 10; \
       done \
    && chown -R ubuntu:ubuntu /opt/code-server-extensions

# ─── 4c. languagepacks.json generator script (runs at container startup) ─
COPY scripts/create-languagepacks.sh /opt/create-languagepacks.sh
RUN chmod +x /opt/create-languagepacks.sh

# ─── 5. FUSE for AppImage support (跨平台: amd64/arm64) ─────────────────
# AppImage 需要 FUSE 来挂载文件系统。虽然我们使用解压安装方式,
# 但预装 fuse3 可以让用户选择直接运行 AppImage。
RUN apt-get update && apt-get install -y --no-install-recommends fuse3 libfuse3-3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 5. Supervisor ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 5a. Lightweight web terminal (ttyd) ──────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends ttyd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 5b. Pre-install global AI CLI tools ──────────────────────────────
RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-timeout 300000 && \
    npm install -g @anthropic-ai/claude-code@latest && \
    npm install -g @openai/codex && \
    npm install -g @google/gemini-cli && \
    npm install -g opencode-ai@latest && \
    npm install -g oh-my-opencode && \
    npm install -g vercel && \
    npm install -g wrangler

# ─── 5c. Pre-install OpenClaw globally (易变，放最后避免破坏缓存) ─────
RUN npm install -g openclaw@2026.5.7

# ─── 5c-2. Pre-install DeepSeek Harness globally (易变，紧跟 OpenClaw) ─
# dsh web 常驻服务见 configs/supervisor-deepseek-harness.conf（内端口 10012）。
RUN npm install -g @deepseek-ai/dsh@0.1.2-rc.1

# ─── 5d. sshfs：远程服务器目录挂载到本地做运维 ─────────────────────────
# 放在 npm 层之后,避免让上面的 AI CLI 安装层缓存失效。
# 运行时需要容器有 /dev/fuse + SYS_ADMIN(见 docker-compose.yml)。
RUN apt-get update && apt-get install -y --no-install-recommends sshfs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ─── 5e. webcode-studiod：AI Studio 无头节点 ──────────────────────────
# 放在 base 而不是 Dockerfile：lite / 桌面 / full 三种镜像都要有它。
# lite 里也能跑——这是不链接 tauri 的无头二进制，没有 X 也没有 WebKitGTK 依赖，
# 这正是它和按需安装的那个 AppImage（install-webcode-ai-studio.sh，桌面专用）
# 的根本区别。装在 base 就是一次下载、三个镜像共用同一层。
#
# 放在整个文件靠后：版本跟着 AI Studio 发布走，改得比上面那些都勤，
# 不该让它把 npm / code-server 那几层昂贵的缓存冲掉。
# 默认装最新版：版本号从 R2 的 latest.json 现取，不写死在这里。
# 想复现某次构建就显式传 --build-arg WEBCODE_STUDIOD_VERSION=0.1.66。
ARG WEBCODE_STUDIOD_VERSION=latest
COPY scripts/install-webcode-studiod.sh /tmp/install-webcode-studiod.sh
RUN chmod +x /tmp/install-webcode-studiod.sh \
    && WEBCODE_STUDIOD_VERSION="${WEBCODE_STUDIOD_VERSION}" /tmp/install-webcode-studiod.sh \
    && rm -f /tmp/install-webcode-studiod.sh

# ─── Metadata ───────────────────────────────────────────────────────
ARG WEBCODE_VERSION=dev
ARG CODE_SERVER_VER=4.100.2
LABEL org.opencontainers.image.version="${WEBCODE_VERSION:-dev}" \
      org.opencontainers.image.revision="${CODE_SERVER_VER}" \
      webcode.code-server.version="${CODE_SERVER_VER}" \
      webcode.component="base"

# Set default working directory
WORKDIR /home/ubuntu

#docker build -f Dockerfile.base -t land007/webclaw_base:latest .
# Trigger rebuild 2025-03-05
